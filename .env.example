# Cyber Phone Inspector — environment contract. Copy to .env and fill locally. Never commit .env.
ANDROID_SDK_ROOT=            # Android SDK path, normally /Users/cyberrick/Library/Android/sdk
JAVA_HOME=                   # Android Studio bundled JDK: /Applications/Android Studio.app/Contents/jbr/Contents/Home
CPI_TEST_DEVICE_SERIAL=      # adb serial of Rick's physical test phone (from `adb devices`), used by smoke scripts only
CPI_RELEASE_KEYSTORE_PATH=   # Path to the local release keystore (.jks), outside the repo
CPI_RELEASE_KEYSTORE_PASSWORD=   # Keystore password
CPI_RELEASE_KEY_ALIAS=       # Key alias inside the keystore
CPI_RELEASE_KEY_PASSWORD=    # Key password
CPI_IOC_SOURCE_URL=          # Pinned MVT STIX2 bundle URL used by tools/fetch_iocs.py; the only URL allowed
